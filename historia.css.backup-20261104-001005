
.historia-pagina {
  position: relative;
  z-index: 1;
  max-width: 1030px;
  margin: auto;
  padding: 75px 20px 60px;
}

.historia-topo {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 55px;
}

.historia-topo h1 {
  font-size: clamp(36px, 6vw, 65px);
  line-height: 1.2;
  margin: 10px 0 22px;
  color: #fff4fa;
}

.historia-topo h1 em {
  display: block;
  font-family: Georgia, serif;
  font-weight: 400;
  color: #f1a3c2;
  margin-top: 12px;
}

.historia-topo > p:last-child {
  color: #e4cbd6;
  font-size: 15px;
  line-height: 1.9;
}

.linha-do-tempo {
  display: grid;
  gap: 25px;
}

.momento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: center;
  background: rgba(42, 24, 42, 0.82);
  border: 1px solid rgba(255, 209, 231, 0.19);
  border-radius: 27px;
  padding: 25px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.17);
  backdrop-filter: blur(12px);
}

.momento:nth-child(even) .moldura {
  order: 2;
}

.moldura {
  position: relative;
  aspect-ratio: 1.22;
  border-radius: 19px;
  background: linear-gradient(135deg, #5c304b, #b65d87);
  overflow: hidden;
  display: grid;
  place-items: center;
}

.moldura img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 2;
}

.moldura img.invisivel {
  display: none;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12px;
  color: #fff3f8;
  font-size: 52px;
}

.placeholder small {
  font-size: 13px;
}

.momento-texto {
  padding: 15px 5px;
}

.numero {
  font-size: 11px;
  letter-spacing: 2px;
  font-weight: 700;
  color: #e88aaf;
}

.momento-texto h2 {
  font-size: clamp(22px, 3vw, 29px);
  margin: 17px 0;
  color: #fff4fa;
}

.momento-texto p {
  color: #e4cbd6;
  line-height: 1.95;
  font-size: 14px;
}

.proximo {
  margin: 55px auto 22px;
  max-width: 600px;
  text-align: center;
  background: rgba(42, 24, 42, 0.82);
  border: 1px solid rgba(255, 209, 231, 0.19);
  border-radius: 27px;
  padding: 48px 30px;
}

.proximo h2 {
  font-size: 32px;
  margin: 0 0 15px;
}

.proximo > p:not(.etiqueta) {
  color: #e4cbd6;
  line-height: 1.8;
  margin-bottom: 28px;
}

.voltar {
  display: block;
  text-align: center;
  color: #e5b6ca;
  text-decoration: none;
  font-size: 13px;
  margin-top: 25px;
}

.voltar:hover {
  text-decoration: underline;
}

@media (max-width: 650px) {
  .historia-pagina {
    padding: 50px 15px;
  }

  .historia-topo {
    margin-bottom: 35px;
  }

  .momento {
    grid-template-columns: 1fr;
    gap: 15px;
    padding: 17px;
  }

  .momento:nth-child(even) .moldura {
    order: 0;
  }

  .momento-texto {
    padding: 12px 7px;
  }

  .proximo {
    padding: 35px 20px;
  }
}
